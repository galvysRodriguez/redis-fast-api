LOG_LEVEL=INFO
MAX_UPLOAD_MB=100

# Extractor
EXTRACTOR_REPLICAS=1
EXTRACTOR_THREADS=4
# fast | hi_res | ocr_only | auto
UNSTRUCTURED_STRATEGY=fast
# true para PDFs escaneados
DOCLING_DO_OCR=false
CHUNK_MAX_CHARS=1500

# Indexer (micro-batches)
INDEXER_REPLICAS=1
BATCH_MAX_RECORDS=500
BATCH_MAX_WAIT_MS=2000
BULK_MAX_RETRIES=5

# Puerto de la API en el host
API_PORT=8001
